# Optional browser-visible base URL for the Pi agent service. Leave empty when
# WOD and the agent are served from the same smolbox. This is not a key; never
# place real credentials in .env.example.
WOD_AGENT_BASE_URL=

# Google Gemini API Key for image generation
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Groq API Key for WOD-AI workout generation
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
